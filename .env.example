# HammerClassify — Umgebungsvariablen (Vorlage)
# Die echte .env liegt nur auf dem hammerpi (Rechte 600, nie im Repo) und
# wird beim ersten Start von `npm run setup` angelegt.
#
# OMLX-URL/OMLX_KEY sind optional: sie können auch in der App gepflegt
# werden (Ansicht „Einstellungen“), die Datenbank überschreibt die .env-Werte.

PORT=3018
HOST=127.0.0.1
RP_ID=classify.lan.hammerlore.de
RP_NAME=HammerClassify
ORIGIN=https://classify.lan.hammerlore.de
# Muss ≥ 20 Zeichen sein; nur für den allerersten Start (Einrichtungscode)
SETUP_TOKEN=bitte-aendern-mindestens-20-zeichen
SESSION_DAYS=30
DATA_DIR=/mnt/nvme/hammerclassify

# OMLX (KI-Backend, Qwen3.8-27B-MLX-4bit auf dem Mac Studio)
OMLX_URL=https://omlx.lan.hammerlore.de:8443
OMLX_KEY=
